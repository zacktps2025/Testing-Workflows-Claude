# Slack Configuration
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Channel where daily summaries will be posted (channel ID or name)
SLACK_SUMMARY_CHANNEL=general

# Optional: Comma-separated list of channel IDs to monitor
# Leave empty to monitor all channels the bot is in
SLACK_MONITORED_CHANNELS=

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Schedule Configuration
# Cron format: minute hour day-of-month month day-of-week
# Default: 9 AM on weekdays (Mon-Fri)
DAILY_SUMMARY_CRON=0 9 * * 1-5
TIMEZONE=America/New_York

# Database Configuration
DATABASE_PATH=./data/messages.db

# Message Retention (in days)
MESSAGE_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
